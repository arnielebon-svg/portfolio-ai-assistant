# Copy this file to .env for local development: cp .env.example .env
# .env is git-ignored. Never commit a real key.
# In production, set these in your host's dashboard (Vercel: Project, Settings, Environment Variables).

# Your Anthropic API key, from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Set to 1 to use canned answers instead of the API (no key, no cost). Leave empty in production.
ASSISTANT_MOCK=

# Only for npm run evals: the endpoint to test. Defaults to http://localhost:3000/api/chat
EVAL_URL=
